<Window x:Class="ReadAndWrite.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Справка — Читай, Пиши и не спиши" 
        Height="550" Width="750"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#1e3a5f">
            <StackPanel Margin="15">
                <TextBlock Text="СОДЕРЖАНИЕ" FontSize="16" FontWeight="Bold" 
                           Foreground="White" Margin="0,0,0,15"/>

                <Button x:Name="BtnIntro" Content="1. О программе" 
                        Background="Transparent" Foreground="White"
                        BorderThickness="0" FontSize="13"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="10,8" Margin="0,0,0,3" Cursor="Hand"
                        Click="BtnIntro_Click"/>
                <Button x:Name="BtnReg" Content="2. Регистрация и вход" 
                        Background="Transparent" Foreground="White"
                        BorderThickness="0" FontSize="13"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="10,8" Margin="0,0,0,3" Cursor="Hand"
                        Click="BtnReg_Click"/>
                <Button x:Name="BtnCatalog" Content="3. Каталог книг" 
                        Background="Transparent" Foreground="White"
                        BorderThickness="0" FontSize="13"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="10,8" Margin="0,0,0,3" Cursor="Hand"
                        Click="BtnCatalog_Click"/>
                <Button x:Name="BtnAuthor" Content="4. Кабинет автора" 
                        Background="Transparent" Foreground="White"
                        BorderThickness="0" FontSize="13"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="10,8" Margin="0,0,0,3" Cursor="Hand"
                        Click="BtnAuthor_Click"/>
                <Button x:Name="BtnAdmin" Content="5. Администрирование" 
                        Background="Transparent" Foreground="White"
                        BorderThickness="0" FontSize="13"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="10,8" Margin="0,0,0,3" Cursor="Hand"
                        Click="BtnAdmin_Click"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1" Margin="25" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentPanel"/>
        </ScrollViewer>
    </Grid>
</Window>