<Window x:Class="ReadAndWrite.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Читай, Пиши и не спиши" 
        Height="550" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center">

            <TextBlock x:Name="TbTitle" Text="ВХОД" FontSize="24" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <TextBlock x:Name="LblDisplayName" Text="Отображаемое имя" Margin="0,5,0,0" Visibility="Collapsed"/>
            <TextBox x:Name="TbDisplayName" Height="28" FontSize="14" Visibility="Collapsed"/>

            <TextBlock x:Name="LblEmail" Text="Email" Margin="0,5,0,0" Visibility="Collapsed"/>
            <TextBox x:Name="TbEmail" Height="28" FontSize="14" Visibility="Collapsed"/>

            <ComboBox x:Name="CbRole" Height="28" FontSize="14" Visibility="Collapsed">
                <ComboBoxItem Content="Читатель" Tag="Reader" IsSelected="True"/>
                <ComboBoxItem Content="Автор" Tag="Author"/>
            </ComboBox>

            <TextBlock Text="Логин" Margin="0,10,0,0"/>
            <TextBox x:Name="TbLogin" Height="28" FontSize="14"/>

            <TextBlock Text="Пароль" Margin="0,10,0,0"/>
            <PasswordBox x:Name="PbPassword" Height="28" FontSize="14"/>

            <TextBlock x:Name="TbError" Foreground="Red" Margin="0,10,0,0" 
                       HorizontalAlignment="Center" TextWrapping="Wrap"/>

            <Button x:Name="BtnLogin" Content="Войти" Height="32" FontSize="14" 
                    Margin="0,15,0,0" Click="BtnLogin_Click"
                    Background="#1a1a2e" Foreground="White"/>

            <Button x:Name="BtnRegister" Content="Регистрация" Height="32" FontSize="14" 
                    Margin="0,5,0,0" Click="BtnRegister_Click"
                    Background="Transparent" Foreground="#1a1a2e"/>

            <Button x:Name="BtnSwitchToLogin" Content="← Вернуться ко входу" Height="32" FontSize="14" 
                    Margin="0,10,0,0" Click="BtnSwitchToLogin_Click"
                    Background="Transparent" Foreground="#2e86c1" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Window>