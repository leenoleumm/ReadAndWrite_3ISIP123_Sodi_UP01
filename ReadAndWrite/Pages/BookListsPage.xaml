<Page x:Class="ReadAndWrite.BookListsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Списки книг" Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Мои списки книг" FontSize="28" FontWeight="Bold" 
                   Foreground="#1e3a5f" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="BtnReading" Content="📖 Читаю" Width="120" Height="35"
                    Margin="0,0,5,0" Background="#1e3a5f" Foreground="White"
                    BorderThickness="0" FontSize="14" Cursor="Hand" Click="BtnReading_Click"/>
            <Button x:Name="BtnRead" Content="✅ Прочитано" Width="120" Height="35"
                    Margin="0,0,5,0" Background="#2c5282" Foreground="White"
                    BorderThickness="0" FontSize="14" Cursor="Hand" Click="BtnRead_Click"/>
            <Button x:Name="BtnPlanned" Content="📋 В планах" Width="120" Height="35"
                    Margin="0,0,5,0" Background="#2c5282" Foreground="White"
                    BorderThickness="0" FontSize="14" Cursor="Hand" Click="BtnPlanned_Click"/>
            <Button x:Name="BtnAbandoned" Content="🚫 Заброшено" Width="120" Height="35"
                    Background="#2c5282" Foreground="White"
                    BorderThickness="0" FontSize="14" Cursor="Hand" Click="BtnAbandoned_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="SearchBox" Width="250" Height="30" FontSize="14"
                     Margin="0,0,10,0" TextChanged="SearchBox_TextChanged"
                     VerticalContentAlignment="Center"/>
            <ComboBox x:Name="GenreFilter" Width="150" Height="30" FontSize="14"
                      Margin="0,0,10,0" SelectionChanged="GenreFilter_SelectionChanged">
                <ComboBoxItem Content="Все жанры" IsSelected="True"/>
            </ComboBox>
            <ComboBox x:Name="SortOrder" Width="150" Height="30" FontSize="14"
                      SelectionChanged="SortOrder_SelectionChanged">
                <ComboBoxItem Content="По названию" Tag="title" IsSelected="True"/>
                <ComboBoxItem Content="По рейтингу" Tag="rating"/>
            </ComboBox>
        </StackPanel>

        <ScrollViewer Grid.Row="3">
            <WrapPanel x:Name="BookGrid"/>
        </ScrollViewer>
    </Grid>
</Page>