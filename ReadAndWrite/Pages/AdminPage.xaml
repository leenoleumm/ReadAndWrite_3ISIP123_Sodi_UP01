<Page x:Class="ReadAndWrite.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Администрирование" Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Администрирование" FontSize="28" FontWeight="Bold" 
                   Foreground="#1e3a5f" Margin="0,0,0,15"/>
        <TabControl x:Name="MainTabControl" Grid.Row="1">
            <TabItem Header="🚩 Жалобы">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ReportsPanel" Margin="15"/>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="👤 Заявки на автора">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="AuthorRequestsPanel" Margin="15"/>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="🔓 Заявки на разморозку">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="UnfreezePanel" Margin="15"/>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="📋 Пользователи">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="UsersPanel" Margin="15"/>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="🔒 Заморожено">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <TextBlock Text="Замороженные пользователи" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                        <StackPanel x:Name="FrozenUsersPanel" Margin="0,0,0,20"/>

                        <TextBlock Text="Замороженные книги" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                        <StackPanel x:Name="FrozenBooksPanel" Margin="0,0,0,20"/>

                        <TextBlock Text="Замороженные отзывы" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                        <StackPanel x:Name="FrozenReviewsPanel"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Page>