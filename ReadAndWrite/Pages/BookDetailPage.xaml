<Page x:Class="ReadAndWrite.BookDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Книга" Background="White">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Width="180" Height="260">
                <Border CornerRadius="10" Background="#1e3a5f" ClipToBounds="True">
                    <Image x:Name="BookCover" Stretch="UniformToFill" Visibility="Collapsed"/>
                </Border>
                <TextBlock x:Name="NoCoverIcon" Text="📖" FontSize="70"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="White"/>
            </Grid>

            <StackPanel Grid.Column="1" Margin="20,0,0,0">
                <TextBlock x:Name="BookTitle" FontSize="24" FontWeight="Bold" 
                           Foreground="#1e3a5f" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock x:Name="BookAuthor" FontSize="16" Foreground="Gray" 
                               VerticalAlignment="Center"/>
                    <Button Content="🚩 Жалоба на автора" FontSize="12" 
                            Background="#f39c12" Foreground="White" BorderThickness="0"
                            Margin="20,0,0,0" Padding="10,5" Cursor="Hand" 
                            Click="ReportAuthor_Click"/>
                </StackPanel>
                <TextBlock x:Name="BookRating" FontSize="18" Margin="0,10,0,0" 
                           Foreground="#f1c40f"/>
                <TextBlock x:Name="BookGenres" FontSize="13" Margin="0,5,0,0"/>
                <TextBlock x:Name="BookDesc" TextWrapping="Wrap" Margin="0,10,0,0" 
                           FontSize="14" Foreground="#555"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#f8f9fa" Padding="15" Margin="0,15,0,0" CornerRadius="8">
            <StackPanel>
                <TextBlock Text="📖 Текст книги" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="BookText" TextWrapping="Wrap" FontSize="14"/>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="💬 Отзывы" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                    <Border Background="#e8f4f8" Padding="15" CornerRadius="8" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Оставить отзыв" FontSize="14" FontWeight="Bold"/>
                            <ComboBox x:Name="ReviewRating" Margin="0,10,0,0" Width="200">
                                <ComboBoxItem Content="10 — Шедевр" Tag="10"/>
                                <ComboBoxItem Content="9 — Отлично" Tag="9"/>
                                <ComboBoxItem Content="8 — Хорошо" Tag="8"/>
                                <ComboBoxItem Content="7 — Неплохо" Tag="7"/>
                                <ComboBoxItem Content="6 — Средне" Tag="6" IsSelected="True"/>
                                <ComboBoxItem Content="5 — Посредственно" Tag="5"/>
                                <ComboBoxItem Content="4 — Плохо" Tag="4"/>
                                <ComboBoxItem Content="3 — Ужасно" Tag="3"/>
                                <ComboBoxItem Content="2 — Кошмар" Tag="2"/>
                                <ComboBoxItem Content="1 — Отвратительно" Tag="1"/>
                            </ComboBox>
                            <TextBox x:Name="ReviewText" Height="60" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            <Button Content="✉ Отправить" Width="150" Height="30"
                                    Margin="0,10,0,0" Background="#1e3a5f" Foreground="White"
                                    BorderThickness="0" Cursor="Hand" Click="SubmitReview_Click"/>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="ReviewsPanel"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="FreezeBookBtn" Content="🔒 Заморозить книгу" 
                        Background="#e74c3c" Foreground="White" BorderThickness="0"
                        Padding="15,8" Margin="0,0,10,0" Cursor="Hand" Click="FreezeBook_Click"
                        Visibility="Collapsed"/>
                <Button Content="🚩 Жалоба на книгу" 
                        Background="#f39c12" Foreground="White" BorderThickness="0"
                        Padding="15,8" Margin="0,0,10,0" Cursor="Hand" Click="ReportBook_Click"/>
                <Button Content="⬅ Назад в каталог" 
                        Background="#95a5a6" Foreground="White" BorderThickness="0"
                        Padding="15,8" Cursor="Hand" Click="BackToCatalog_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>