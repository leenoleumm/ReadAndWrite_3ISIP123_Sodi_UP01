<Page x:Class="ReadAndWrite.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Профиль" Background="White">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Мой профиль" FontSize="28" FontWeight="Bold" Foreground="#1e3a5f"/>

        <Border Grid.Row="1" Background="#f8f9fa" Padding="20" CornerRadius="10" Margin="0,15,0,0">
            <StackPanel>
                <TextBlock x:Name="ProfileName" FontSize="20" FontWeight="Bold"/>
                <TextBlock x:Name="ProfileLogin" FontSize="14" Foreground="Gray" Margin="0,5,0,0"/>
                <TextBlock x:Name="ProfileEmail" FontSize="14" Foreground="Gray"/>
                <TextBlock x:Name="ProfileRole" FontSize="14" Foreground="#2e86c1" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <Button Grid.Row="2" x:Name="BtnRequestAuthor" Content="✏️ Подать заявку на роль Автора"
                Width="280" Height="35" Margin="0,15,0,0"
                Background="#1e3a5f" Foreground="White" BorderThickness="0"
                FontSize="14" Cursor="Hand" Click="BtnRequestAuthor_Click"/>

        <Border Grid.Row="3" x:Name="FreezeWarning" Background="#fdecea" 
                Padding="15" CornerRadius="8" Margin="0,15,0,0" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="⚠️ Ваш аккаунт заморожен!" FontSize="16" FontWeight="Bold" 
                           Foreground="#c0392b"/>
                <TextBlock x:Name="FreezeReason" TextWrapping="Wrap" Margin="0,5,0,0"/>
                <Button Content="📩 Оспорить заморозку" Width="200" Height="30"
                        Margin="0,10,0,0" Background="#c0392b" Foreground="White"
                        BorderThickness="0" Cursor="Hand" Click="AppealFreeze_Click"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="4" Margin="0,15,0,0">
            <StackPanel>
                <TextBlock Text="Мои отзывы" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                <StackPanel x:Name="MyReviewsPanel"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>