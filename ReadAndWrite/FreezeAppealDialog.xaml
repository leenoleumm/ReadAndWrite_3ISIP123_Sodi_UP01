<Window x:Class="ReadAndWrite.FreezeAppealDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оспорить заморозку" Height="200" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Укажите причину для разморозки:" FontSize="14" Margin="0,0,0,10"/>
            <TextBox x:Name="TbReason" Height="60" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Отмена" Width="80" Margin="0,0,10,0" Click="Cancel_Click"/>
                <Button Content="Отправить" Width="80" Background="#1e3a5f" 
                        Foreground="White" BorderThickness="0" Click="Submit_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>